mpvc_web_select_form()
{
    cmd="$1"
    arg="${2:-}"

    echo "<form action=/ method=get>"
    echo "<span title=$arg ></span>"
    echo "<select name=cli $arg onchange=this.form.submit() >"
    awk -v cmd="$cmd" '
        BEGIN  { print "<option value=\"\" selected># "cmd }
        NR > 0 { gsub("\"",""); print "<option value=\""cmd" "$0"\">"$0 }
    '
    echo '</select>'
    echo '</form>'
}

mpvc_web_yts()
{
cat <<EOF
            <script>
            function mpvcYtsOnKeyDownEvent(event, form) {
                if (event.keyCode !== 13) return;

                event.preventDefault();

                var input = form.querySelector('input[name="mpvc-yts-query"]');
                var select = document.getElementById('mpvc-yts-select');
                var query = input.value.trim();

                if (!query) {
                    select.innerHTML = '<option value="" disabled selected>Please enter a search term</option>';
                    return;
                }

                select.innerHTML = '<option value="" disabled selected>Loading...</option>';
                select.disabled = true;
                input.disabled = true;

                var url = '';

                url = '/cgi-bin/mpvc?mpvc-fzf+-s+' + encodeURIComponent(query);
                mpvcHttpGet(url)
                    .then(data => {
                        if (!data || data.trim() === '') {
                            select.innerHTML = '<option value="" disabled selected>No results found</option>';
                            input.disabled = false;
                            select.disabled = false;
                            return;
                        }

                        var lines = data.split('\n').filter(line => line.trim() !== '');
                        if (lines.length === 0) {
                            select.innerHTML = '<option value="" disabled selected>No results found</option>';
                            input.disabled = false;
                            select.disabled = false;
                            return;
                        }

                        var html = '<option value="" disabled>- Select a result to add -</option>';
                        for (var i = 0; i < lines.length; i++) {
                            var line = lines[i];
                            var parts = line.split(/\s+/);
                            var url = parts[0];

                            html += '<option value="' +
                                    url.replace(/"/g, '&quot;') +
                                    '">' +
                                    line.replace(/</g, '&lt;').replace(/>/g, '&gt;') +
                                    '</option>';
                        }

                        // expand the select
                        select.innerHTML = html;
                        select.size = Math.min(lines + 1, 8);
                        select.disabled = false;
                        input.disabled = false;
                        select.focus();
                    })
                    .catch(error => {
                        console.error('Search error:', error);
                        select.innerHTML = '<option value="" disabled selected>Search failed. Try again.</option>';
                        input.disabled = false;
                        select.disabled = false;
                    });
            }

            // Handle Go button click: apply action to all selected results
            function mpvcYtsSearchSubmit() {
                var selectElement = document.getElementById('mpvc-yts-select');
                var actionElement = document.getElementById('mpvc-yts-search-action');
                var selectedOptions = selectElement.selectedOptions;

                if (selectedOptions.length === 0) {
                    console.log('No results selected');
                    return;
                }

                // Process each selected result
                var action = actionElement.value;
                for (var i = 0; i < selectedOptions.length; i++) {
                    var yturl = selectedOptions[i].value;
                    var url = '/cgi-bin/mpvc?mpvc+' + action + '+' + yturl;
                    mpvcHttpGet(url);
                }

                // Clear selection after submission
                selectElement.value = '';
            }
            </script>

            <!-- YTS Search Form (mobile-optimized with <select> fallback) -->
            <form id="mpvc-yts-form" action="/" method="get" class="yts-search-form">
                <label for="mpvc-yts-input"></label>
                <input type="search"
                       id="mpvc-yts-input"
                       name="mpvc-yts-query"
                       placeholder="🔍 Type to search music ..."
                       title="Search YouTube or paste video URL (press Enter)"
                       $MPVC_WEB_SHORTCUT_YTSEARCH
                       onkeydown="mpvcYtsOnKeyDownEvent(event, this.form)">

                <button id="mpvc-yts-search-submit" type="button" onclick="mpvcYtsSearchSubmit()">Go</button>

                <select name="mpvc-yts-url"
                        id="mpvc-yts-select"
                        title="Search results"
                        multiple
                        size="1"
                        style="margin-bottom: -6px; resize: auto;"
                        >
                    <option value="" disabled selected>Your search results</option>
                </select>

                <select id="mpvc-yts-search-action">
                    <option value="add">play-last</option>
                    <option value="playnext">play-next</option>
                    <option value="playnow">play-now</option>
                    <option value="mpvc-fzf+-g">download</option>
                    <option value="mpvc-fzf+-a">stash</option>
                </select>

            </form

</form>
EOF
}

