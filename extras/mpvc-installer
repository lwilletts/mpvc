#!/usr/bin/env sh
#
# @file mpvc-installer
# @description mpvc installer
# @author gmt4 <gmt4 at github.com> (c) Copyright 2022 GPLv2+
# @url github.com/gmt4/mpvc
# SPDX-License-Identifier: GPL-2.0-or-later
#

PROGNAME=${0##*/}
PROGVERSION="v1.8"
PROGAUTHOR=gmt4
PROGURL="https://github.com/gmt4/mpvc"

set -euf

SHELL="${SHELL:-/bin/sh}"
PREFIX="${PREFIX:-/usr/local}"
BINDIR="${BINDIR:-$PREFIX/bin}"
DOCDIR="${DOCDIR:-$PREFIX/docs}"
MANDIR="${MANDIR:-$PREFIX/man/man1}"
LICDIR="${LICDIR:-$PREFIX/licenses}"

MPV_CONFIG_DIR="${MPV_CONFIG_DIR:-$HOME/.config/mpv}"
MPVC_CONFIG_DIR="${MPVC_CONFIG_DIR:-$HOME/.config/mpvc}"

MANS="docs/man/man1/mpvc.1 docs/man/man1/mpvc-fzf.1 docs/man/man1/mpvc-tui.1"
DOCS="README.md docs/config/mpv.conf docs/logbook.html"
LICENSES="LICENSE.md"
SCRIPT="mpvc extras/mpvc-tui extras/mpvc-fzf extras/mpvc-cut extras/mpvc-chapter extras/mpvc-mpris extras/mpvc-equalizer extras/mpvc-web extras/mpvc-web-browser extras/mpvc-autopilot extras/mpvc-installer"

MPV_CONFIG="docs/config/mpv.conf"
MPVC_CONFIG="docs/config/mpvc.conf docs/config/yt-dlp.conf docs/config/curlrc"

MPVC_INSTALL_TOOLS_REQUIRED="sh mpv fzf socat sed awk"
MPVC_INSTALL_TOOLS_RECOMMENDED="awk curl jq rlwrap notify-send qrencode yt-dlp deno"

mpvc_config()
{
    mkdir -p "$MPV_CONFIG_DIR/scripts/"
    echo "Fetching docs/mpv.conf from $PROGURL"
    for config in ${MPV_CONFIG};
    do
        file="$MPV_CONFIG_DIR/${config##*/}"
        url="$PROGURL/raw/master/$config"
        echo "Fetch $file"
        if [ -f "$file" ]; then
            echo "$PROGNAME: $file exists. Not overwriting."
        else
            curl -fsSL -o "$file" "$url"
        fi
        chmod 644 "$file"
    done

    mkdir -p "$MPVC_CONFIG_DIR"
    echo "Fetching $MPVC_CONFIG from $PROGURL"
    for config in ${MPVC_CONFIG};
    do
        file="$MPVC_CONFIG_DIR/${config##*/}"
        url="$PROGURL/raw/master/$config"
        echo "Fetch $file"
        if [ -f "$file" ]; then
            echo "$PROGNAME: $file exists. Not overwriting."
        else
            curl -fsSL -o "$file" "$url"
        fi
        chmod 644 "$file"
    done

    for bin in "yt-dlp"
    do
        file="$BINDIR/$bin"
        echo "Fetch $file"
        if [ -f "$file" ]; then
            echo "$PROGNAME: $file exists. Not overwriting."
        else
            if curl -fsSL -o "$file" "https://github.com/$bin/$bin/releases/latest/download/$bin"; then
                chmod a+rx "$file"
            fi
        fi
    done

    for bin in "deno"
    do
        file="$BINDIR/$bin"
        echo "Fetch $file"
        if [ -f "$file" ]; then
            echo "$PROGNAME: $file exists. Not overwriting."
        else
            if curl -m 20 -fsSL -o - "https://github.com/denoland/$bin/releases/latest/download/$bin-$(uname -m)-unknown-linux-gnu.zip" | gunzip > "$file"; then
                chmod a+rx "$file"
            fi
        fi
    done
}

mpvc_fetch()
{
    mkdir -p "$BINDIR"
    echo "Fetching mpvc from $PROGURL"
    for script in ${SCRIPT};
    do
        file="$BINDIR/${script##*/}"
        url="$PROGURL/raw/master/$script"
        echo "Fetch $file"
        #if [ -f "$file" ]; then echo "$PROGNAME: $file exists, overwriting."; fi
        if curl -fsSL -o "$file" "$url"; then
            chmod u+x "$file"
        fi
    done
}

mpvc_man()
{
    mkdir -p "$MANDIR"
    for man in ${MANS};
    do
        install -Dvm644 "$(pwd)/$man" "$MANDIR";
    done
}

mpvc_docs()
{
    mkdir -p "$DOCDIR"
    for doc in ${DOCS};
    do
        install -Dvm640 "$(pwd)/$doc" "$DOCDIR";
    done
}

mpvc_licenses()
{
    mkdir -p "$LICDIR"
    for license in ${LICENSES};
    do
        install -Dvm644 "$(pwd)/$license" "$LICDIR";
    done
}

mpvc_link()
{
    mkdir -p "$BINDIR"
    if ln -v 2>&1 | grep -q 'ln: unknown option'; then lnops=-sfn; else lnops=-sfnv; fi
    for f in $SCRIPT;
    do
        ln "$lnops" "$(pwd)/$f" "$BINDIR";
    done
}

mpvc_install()
{
    echo 'Installing mpvc...'
    mkdir -p "$BINDIR"
    for script in ${SCRIPT};
    do
        install -Dvm755 "$(pwd)/$script" "$BINDIR";
    done
}

mpvc_uninstall()
{
    echo 'Un-installing mpvc...'
    for script in ${SCRIPT};
    do
        rm -v "$BINDIR/${script##*/}";
    done
    for external in "yt-dlp" "deno";
    do
        rm -v  "$BINDIR/${external##*/}";
    done

}

mpvc_check_requirements()
{
    # attempt at listing packages required by mpvc & extras/ to work
    echo "# Checking required deps:"
    for cmd in $MPVC_INSTALL_TOOLS_REQUIRED; do
        (command -v "$cmd" || echo "$PROGNAME: Error: No $cmd found. Install to continue") | sed 's/^/  /'
    done
    # recommened, and good to have, but not required
    echo "# Checking recommended deps:"
    for cmd in $MPVC_INSTALL_TOOLS_RECOMMENDED; do
        if command -v "$cmd" | sed 's/^/  /'; then
            $cmd --version | awk 'NR==1 { print "    "$1,$2,$3 }'
        else
            echo "$PROGNAME: Warning: No $cmd found, is recommended, but not required"
        fi
    done
}

mpvc_check_update()
{
    master=$(curl -fsSL "$PROGURL/raw/master/extras/$PROGNAME" |
        awk '/^PROGVERSION=/ { gsub("PROGVERSION=",""); gsub("\\x22",""); print}'
    )

    if [ "$PROGVERSION" = "$master" ]
    then
        echo "$PROGNAME: Not-Found new version at $PROGURL (latest: $master)"
    else
        echo "$PROGNAME: Found new version at $PROGURL (latest: $master)"
    fi
}

mpvc_quickstart()
{
    export BINDIR="${BINDIR:-$HOME/bin}"
    if [ ! -d "$BINDIR" ]; then
        echo "# Quickstart: Creating target directory: $BINDIR"
        if ! mkdir -p "$BINDIR"; then
            echo "❌ Quickstart failed: Failed to create directory $BINDIR"
            return 1
        fi
    fi

    echo "# Quickstart: Checking for updates..."
    if ! "$0" check-update; then
        echo "❌ Quickstart failed: 'check-update' step encountered an error."
        return 1
    fi

    echo "# Quickstart: Fetching/installing files..."
    if ! "$0" fetch-user; then
        echo "❌ Quickstart failed: 'fetch-user' step encountered an error."
        return 1
    fi

    echo "# Quickstart: Configuring user directories..."
    if ! "$0" config-user; then
        echo "❌ Quickstart failed: 'config-user' step encountered an error."
        return 1
    fi

    echo "# Quickstart: Checking system requirements..."
    if ! "$0" check-reqs; then
        echo "❌ Quickstart failed: 'check-reqs' dependency check failed."
        return 1
    fi

    # 4. Path validation check
    case ":$PATH:" in
        *:"$BINDIR":*) ;;
        *)
            echo ""
            echo "⚠️  Note: '$BINDIR' not found in \$PATH. To fix this, update your shell config with:"
            echo "  export PATH=\"\$HOME/bin:\$PATH\""
            ;;
    esac

    echo "# QuickStart setup completed successfully!"
}

mpvc_quickstart_uninstall()
{
    export BINDIR="${BINDIR:-$HOME/bin}"

    echo "# QuickStart: Removing mpvc binaries from $BINDIR..."
    if ! "$0" uninstall-user; then
        echo "❌ Quickstart failed: 'uninstall-user' step encountered an error."
        return 1
    fi

    _config_dir="$HOME/.config/mpvc"
    if [ -d "$_config_dir" ] || [ -L "$_config_dir" ]; then
        echo "# QuickStart: Keeping mpvc user config at $_config_dir."
    else
        echo "# QuickStart: No mpvc user config found at $_config_dir (skipping)."
    fi

    echo "# QuickStart uninstall complete!"
}

mpvc_version()
{
    echo "usage: $PROGNAME args # @version $PROGVERSION (c) $PROGAUTHOR $PROGURL"
}

usage()
{
    cat <<EOF
usage: $PROGNAME args # @version $PROGVERSION (c) $PROGAUTHOR $PROGURL
  quickstart     : QuickStart Install for first-time users
  quickstart-rm  : QuickStart Removal for first-time users

  check-update   : Check for updates
  check-reqs     : Check for required packages
  config         : Fetch mpv config
  config-user    : Fetch mpv config to BINDIR=$HOME/bin
  config-sys     : Fetch mpv config to BINDIR=$PREFIX/bin
  fetch-user     : Fetch to BINDIR=$HOME/bin
  link-user      : Symlink to BINDIR=$HOME/bin
  install        : Install to BINDIR=$PREFIX/bin
  uninstall      : Uninstall from BINDIR=$PREFIX/bin
  install-user   : Install to BINDIR=$HOME/bin
  install-sys    : Install to BINDIR=$PREFIX/bin (sets PREFIX=/usr/local)
  uninstall-user : Uninstall from BINDIR=$HOME/bin
  uninstall-sys  : Uninstall from BINDIR=$PREFIX/bin (sets PREFIX=/usr/local)
*tips: If unsure where to start, start with: $PROGNAME quickstart
EOF
    exit
}

main()
{
    if [ $# -lt 1 ]; then usage; fi

    # hack to force SHELL back to POSIX-sh when using non POSIX-sh shells (macOS)
    case "$SHELL" in *'zsh'|*'fish')
        echo "$PROGNAME: Warning Forcing SHELL=/bin/sh, current SHELL=$SHELL is not POSIX-sh"; SHELL="/bin/sh";;
    esac

    case "$1" in
    quickstart)      shift; mpvc_quickstart ;;
    quickstart-rm)   shift; mpvc_quickstart_uninstall ;;

    version)         shift; mpvc_version;;
    check-reqs)      shift; mpvc_check_requirements;;
    check-update)    shift; mpvc_check_update;;
    man)             shift; mpvc_man "$@";;
    docs)            shift; mpvc_docs "$@";;
    licenses)        shift; mpvc_licenses "$@";;
    fetch)           shift; mpvc_fetch "$@";;
    link)            shift; mpvc_link "$@";;
    install)         shift; mpvc_install "$@";;
    uninstall)       shift; mpvc_uninstall "$@";;
    config)          shift; mpvc_config "$@";;

    config-user)     shift; PREFIX=$HOME $SHELL "$0" config;;
    config-sys)      shift; PREFIX=/usr/local $SHELL "$0" config;;

    fetch-user)      shift; PREFIX=$HOME $SHELL "$0" fetch;;
    fetch-sys)       shift; PREFIX=/usr/local $SHELL "$0" fetch;;

    link-user)       shift; PREFIX=$HOME $SHELL "$0" link;;
    install-user)    shift; PREFIX=$HOME $SHELL "$0" install;;
    install-sys)     shift; PREFIX=/usr/local $SHELL "$0" install;;

    uninstall-user)  shift; PREFIX=$HOME $SHELL "$0" uninstall;;
    uninstall-sys)   shift; PREFIX=/usr/local $SHELL "$0" uninstall;;

    *) usage;;
    esac
}

main "$@"
